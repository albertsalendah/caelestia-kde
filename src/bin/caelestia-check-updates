#!/usr/bin/env bash
# caelestia-check-updates - run by a systemd timer: count pending updates and notify.
export PATH="$HOME/.local/bin:$PATH"

# Where this install's updates come from. An install records the repository it was made from
# (.update_source) and the branch (.update_branch); one with no record is upstream's, as it always
# was. src/bin/caelestia-check-updates carries an identical copy of this function, and
# tests/test_update_source.sh keeps the two the same.
UPSTREAM_REPO="https://github.com/ladybug-me/caelestia-kde.git"
resolve_update_source() {
    local config="${1:-$HOME/.config/quickshell/caelestia}" recorded branch

    REPO_URL="$UPSTREAM_REPO"
    IS_FORK=0
    FORK_BRANCH=""

    recorded="$(head -n 1 -- "$config/.update_source" 2>/dev/null | tr -d '[:space:]')"
    if [[ -z "$recorded" || "${recorded,,}" == "${UPSTREAM_REPO,,}" ]]; then
        return 0
    fi

    REPO_URL="$recorded"
    IS_FORK=1
    branch="$(head -n 1 -- "$config/.update_branch" 2>/dev/null | tr -d '[:space:]')"
    if [[ -n "$branch" && "$branch" != "HEAD" ]]; then
        FORK_BRANCH="$branch"
    fi
}

# A test sources this file for the function above; stop here so nothing below runs.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

# No git, nothing to check.
if ! command -v git &> /dev/null; then
    exit 0
fi

# Honor the Nexus "check for updates" setting.
if command -v jq >/dev/null && [ -f "$HOME/.config/caelestia/shell.json" ]; then
    CHECK_UPDATES=$(jq -r '.general.checkUpdates // true' "$HOME/.config/caelestia/shell.json" 2>/dev/null)
    if [ "$CHECK_UPDATES" = "false" ]; then
        exit 0
    fi
fi

# UI updates (GitHub)
REPO="$HOME/.cache/caelestia-update-repo"
resolve_update_source
if [ "$IS_FORK" -eq 1 ]; then
    # An install made from a fork follows the branch it was made from, in that fork.
    BRANCH="$FORK_BRANCH"
else
    BRANCH=$(cat "$HOME/.config/quickshell/caelestia/.update_branch" 2>/dev/null || echo "main")
    if [ "$BRANCH" != "main" ] && [ "$BRANCH" != "dev" ]; then
        BRANCH="main"
    fi
fi

# No interactive prompts, and a timeout so a hung network cannot stall the timer.
export GIT_TERMINAL_PROMPT=0
GIT_TIMEOUT=30

# --exit-code makes git report 2 when no ref matches; every other status is the query
# itself failing (offline, DNS, timeout). Only "the branch is gone" may rewrite the user's
# stored choice, or a laptop that is briefly offline silently moves itself to main.
ls_status=0
if [ -n "$BRANCH" ]; then
    timeout ${GIT_TIMEOUT} git ls-remote --exit-code --heads "$REPO_URL" "$BRANCH" >/dev/null 2>&1 || ls_status=$?
fi
if [ "$ls_status" -eq 2 ]; then
    if [ "$IS_FORK" -eq 1 ]; then
        # A fork has no main to fall back to, and the recorded branch is not ours to rewrite.
        echo "[WARN] Branch '$BRANCH' does not exist on $REPO_URL; not checking for updates." >&2
        BRANCH=""
    else
        echo "[WARN] Branch '$BRANCH' does not exist on the remote; falling back to main." >&2
        BRANCH="main"
        mkdir -p "$HOME/.config/quickshell/caelestia"
        echo "$BRANCH" > "$HOME/.config/quickshell/caelestia/.update_branch"
    fi
fi

_localCommit="$(cat "$HOME/.config/quickshell/caelestia/.current_commit" 2>/dev/null)"
CAELESTIA_PENDING=0

if [ -n "$_localCommit" ] && [ -n "$BRANCH" ]; then
    # The cache has to be a clone of this install's repository; one made for another is dropped.
    if [ -d "$REPO" ] && [ "$(git -C "$REPO" remote get-url origin 2>/dev/null)" != "$REPO_URL" ]; then
        rm -rf -- "$REPO"
    fi
    if [ ! -d "$REPO" ]; then
        timeout ${GIT_TIMEOUT} git clone --bare --filter=blob:none "$REPO_URL" "$REPO" >/dev/null 2>&1 || true
    else
        timeout ${GIT_TIMEOUT} git -C "$REPO" fetch --force origin "$BRANCH:$BRANCH" >/dev/null 2>&1 || true
    fi

    LOCAL_DATE=$(git -C "$REPO" show -s --format=%cI ${_localCommit} 2>/dev/null)
    if [ -n "$LOCAL_DATE" ]; then
        CAELESTIA_PENDING=$(git -C "$REPO" log --oneline --since="$LOCAL_DATE" ${_localCommit}..${BRANCH} 2>/dev/null | wc -l)
    else
        CAELESTIA_PENDING=$(git -C "$REPO" log --oneline ${_localCommit}..${BRANCH} 2>/dev/null | wc -l)
    fi
fi

# System updates
SYSTEM_PENDING=0

if command -v checkupdates >/dev/null; then
    PACMAN_PENDING=$(checkupdates 2>/dev/null | wc -l)
    SYSTEM_PENDING=$((SYSTEM_PENDING + PACMAN_PENDING))
fi

if command -v flatpak >/dev/null; then
    FLATPAK_PENDING=$(flatpak remote-ls --updates 2>/dev/null | wc -l)
    SYSTEM_PENDING=$((SYSTEM_PENDING + FLATPAK_PENDING))
fi

if command -v dnf >/dev/null; then
    DNF_OUTPUT=$(dnf check-update --quiet 2>/dev/null) || true
    DNF_PENDING=$(echo "$DNF_OUTPUT" | wc -l)
    SYSTEM_PENDING=$((SYSTEM_PENDING + DNF_PENDING))
fi

if command -v apt-get >/dev/null; then
    APT_PENDING=$(apt-get -s upgrade 2>/dev/null | grep -i "^Inst" | wc -l)
    SYSTEM_PENDING=$((SYSTEM_PENDING + APT_PENDING))
fi

# Notify only when a count went up, so a standing backlog does not re-nag.
CACHE_FILE="$HOME/.cache/caelestia-kde/last_update_counts"
OLD_C=0
OLD_S=0

if [ -f "$CACHE_FILE" ]; then
    read -r OLD_C OLD_S < "$CACHE_FILE"
fi

if [ "$CAELESTIA_PENDING" -gt "${OLD_C:-0}" ] || [ "$SYSTEM_PENDING" -gt "${OLD_S:-0}" ]; then
    TITLE="System Update Available"
    BODY=""
    
    if [ "$CAELESTIA_PENDING" -gt 0 ] && [ "$SYSTEM_PENDING" -gt 0 ]; then
        TITLE="System & UI Updates Available"
        BODY="$CAELESTIA_PENDING UI commits and $SYSTEM_PENDING system packages."
    elif [ "$CAELESTIA_PENDING" -gt 0 ]; then
        TITLE="Caelestia Update Available"
        BODY="$CAELESTIA_PENDING new commits on $BRANCH branch."
    elif [ "$SYSTEM_PENDING" -gt 0 ]; then
        BODY="$SYSTEM_PENDING new system packages."
    fi

    if [ -n "$BODY" ]; then
        # Replace the previous notification and offer an action button.
        NOTIF_ID_FILE="$HOME/.cache/caelestia-kde/last_update_notif_id"
        LAST_ID=""
        if [ -f "$NOTIF_ID_FILE" ]; then
            LAST_ID=$(cat "$NOTIF_ID_FILE")
        fi

        # -t expires the toast, so an ignored notification cannot keep the oneshot unit active.
        NOTIF_ARGS=( -w -p -u normal -i system-software-update -a "Caelestia Updates" -t 300000 )
        if [ -n "$LAST_ID" ]; then
            NOTIF_ARGS+=( -r "$LAST_ID" )
        fi
        
        NOTIF_ARGS+=( -A "run=Install Updates" -A "close=Close" )
        
        # -w blocks until an action is clicked or the toast is dismissed, and prints the key.
        NOTIF_OUT=$(notify-send "${NOTIF_ARGS[@]}" "$TITLE" "$BODY")
        
        # Line 1 is the notification id, line 2 the clicked action.
        echo "$NOTIF_OUT" | head -n 1 > "$NOTIF_ID_FILE"
        
        ACTION=$(echo "$NOTIF_OUT" | sed -n '2p')
        if [ "$ACTION" = "run" ]; then
            if [ -x "$HOME/.local/bin/caelestia" ]; then
                "$HOME/.local/bin/caelestia" shell toggleNexus &
            elif command -v caelestia &> /dev/null; then
                caelestia shell toggleNexus &
            fi
        fi
    fi
fi

mkdir -p "$(dirname "$CACHE_FILE")"
echo "$CAELESTIA_PENDING $SYSTEM_PENDING" > "$CACHE_FILE"
