# Installed as /usr/local/lib/systemd/user/plasma-xembedsniproxy.service, only when the proxy was built
# from src/xembed-sni-proxy (a machine without plasma-workspace). Same name as plasma-workspace's unit,
# so the session program and the drop-in that waits for the tray need no change, and /usr/local wins
# over /usr/lib if plasma-workspace is installed later.
# Unlike plasma-workspace's unit it has no After=plasma-core.target (nothing here starts that target).
[Unit]
Description=Handle legacy xembed system tray icons
PartOf=graphical-session.target

[Service]
ExecStart=/usr/local/bin/caelestia-xembedsniproxy
Restart=on-failure
Type=simple
Slice=background.slice
TimeoutSec=5sec
