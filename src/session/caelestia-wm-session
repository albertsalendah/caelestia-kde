#!/usr/bin/env bash
# caelestia-wm-session: start KWin + the Caelestia shell without Plasma.
# Run by the login manager's session entry (caelestia.desktop), or from a TTY login by its full
# path. Installed to /usr/local/bin by scripts/12-independent-session.sh.
set -u

XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
# Use the systemd user manager's bus (no dbus-run-session), so KWin and every
# user service share one session bus.
export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}"

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=KDE
export XDG_SESSION_DESKTOP=KDE
export KDE_FULL_SESSION=true
export KDE_SESSION_VERSION=6

say() {
    printf 'caelestia-wm-session: %s\n' "$*" >&2
    logger -t caelestia-wm-session -- "$*" 2>/dev/null || true   # also in the journal
}

# Teardown, run once on any exit: KWin ending, a failed start, or a signal. SIGKILL cannot be
# caught. Stopping the target stops KWin, the shell and the autostart apps (all PartOf it).
cleaned=0
splash_pid=""
splash_watch_pid=""
cleanup() {
    [ "$cleaned" = 1 ] && return
    cleaned=1
    # The login splash and what closes it are children of this program; timeout passes the
    # signal on to the splash itself.
    [ -n "$splash_pid" ] && kill "$splash_pid" 2>/dev/null
    [ -n "$splash_watch_pid" ] && kill "$splash_watch_pid" 2>/dev/null
    systemctl --user stop caelestia-session.target 2>/dev/null || true
    systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY 2>/dev/null || true
    # The shell starts only while this file exists (caelestia-shell.service.d), so a Plasma
    # session chosen next does not get it.
    rm -f "$XDG_RUNTIME_DIR/caelestia-session-active"
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'exit 130' INT

# 0. Forget a display left over from an earlier session. If the user manager still carries
#    an old WAYLAND_DISPLAY (for example the manager outlived a session that did not clean
#    up), KWin starts as a nested Wayland client and never drives the screen.
unset WAYLAND_DISPLAY DISPLAY
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY 2>/dev/null || true
# The shell writes this file when it is up (shell.qml), and the login splash waits for it. One
# left over from an earlier login would end the splash at once.
rm -f "$XDG_RUNTIME_DIR/caelestia-shell-ready" "$XDG_RUNTIME_DIR/caelestia-session-active"

# 0b. Source the Plasma environment scripts, as Plasma's startup does: system directories
#     first, then the user's, so the user wins. The installer's caelestia.sh lives here (PATH,
#     QML2_IMPORT_PATH, CAELESTIA_*). set +u because those scripts do not expect it.
env_dirs=()
IFS=: read -ra _cfg_dirs <<< "${XDG_CONFIG_DIRS:-/etc/xdg}"
for _d in "${_cfg_dirs[@]}"; do env_dirs+=("$_d/plasma-workspace/env"); done
env_dirs+=("${XDG_CONFIG_HOME:-$HOME/.config}/plasma-workspace/env")
set +u
for _d in "${env_dirs[@]}"; do
    [ -d "$_d" ] || continue
    for _f in "$_d"/*.sh; do
        [ -r "$_f" ] || continue
        # shellcheck disable=SC1090
        . "$_f" || say "environment script $_f returned an error"
    done
done
set -u

# 1. Share this login's environment with systemd user services and D-Bus-activated
#    programs. KWin needs XDG_SESSION_ID / XDG_VTNR / XDG_SEAT to take over the display.
dbus-update-activation-environment --systemd --all || systemctl --user import-environment

# 2. Start the session (KWin, then graphical-session.target, then caelestia-shell.service).
#    The shell unit has a condition on this file (caelestia-shell.service.d), so it has to exist
#    before graphical-session.target is reached. The exit trap removes it.
: > "$XDG_RUNTIME_DIR/caelestia-session-active"
if ! systemctl --user start caelestia-session.target; then
    say "caelestia-session.target failed to start. See: journalctl --user -b -u caelestia-kwin"
    exit 1
fi

# 3. Make sure user services can see the display. KWin may already have exported it.
if ! systemctl --user show-environment | grep -q '^WAYLAND_DISPLAY='; then
    for sock in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
        [ -S "$sock" ] || continue
        export WAYLAND_DISPLAY="${sock##*/}"
        dbus-update-activation-environment --systemd WAYLAND_DISPLAY
        say "KWin did not export WAYLAND_DISPLAY; imported ${WAYLAND_DISPLAY} instead"
        break
    done
else
    say "WAYLAND_DISPLAY was exported to the user manager by KWin"
fi

# 3a. The login splash (Nexus -> Splash), off unless the user turned it on. Two kinds:
#     - a Plasma splash theme (PlasmaTheme in caelestia-splashrc): ksplashqml, Plasma's own
#       splash runner, draws the theme's Splash.qml. It closes when it is told the sixth stage
#       has come, which finish_plasma_splash does once the shell is ready.
#     - otherwise (or when that cannot start) the Caelestia design: a small Quickshell instance
#       that covers the screen until the shell is ready, then closes itself.
#     Both end after about 20 s whatever happens (timeout is a last guard), their output goes to
#     $XDG_RUNTIME_DIR/caelestia-splash.log, and nothing here may keep the session from starting.
splash_dirs() {
    printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}"
    local IFS=:
    for d in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share}; do printf '%s\n' "$d"; done
}

plasma_splash_exists() {
    local base
    while IFS= read -r base; do
        [ -r "$base/plasma/look-and-feel/$1/contents/splash/Splash.qml" ] && return 0
    done < <(splash_dirs)
    return 1
}

# $1 theme id, $2 display KWin exported, $3 minimum seconds
start_plasma_splash() {
    local ksplash
    ksplash="$(command -v ksplashqml)" || return 1
    plasma_splash_exists "$1" || return 1
    WAYLAND_DISPLAY="$2" timeout --kill-after=3 35 "$ksplash" "$1" >"$XDG_RUNTIME_DIR/caelestia-splash.log" 2>&1 &
    splash_pid=$!
    finish_plasma_splash "$3" &
    splash_watch_pid=$!
}

# Waits for the shell's signal and the minimum time (20 s at most), then walks ksplashqml through
# the stages it still lacks. The sixth ends it; the pause before it lets a theme finish its
# last animation.
finish_plasma_splash() {
    local min="$1" start=$SECONDS stage
    until [ -e "$XDG_RUNTIME_DIR/caelestia-shell-ready" ] && [ $((SECONDS - start)) -ge "$min" ]; do
        [ $((SECONDS - start)) -ge 20 ] && break
        sleep 0.3
    done
    sleep 0.6
    for stage in startPlasma kcminit ksmserver; do
        send_splash_stage "$stage"
    done
    sleep 0.7
    send_splash_stage desktop
}

send_splash_stage() {
    gdbus call --session --dest org.kde.KSplash --object-path /KSplash \
        --method org.kde.KSplash.setStage "$1" >/dev/null 2>&1
}

start_splash() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 0
    local rc=caelestia-splashrc
    [ "$(kreadconfig6 --file "$rc" --group Login --key Enabled --default false)" = true ] || return 0
    local qs shell_config qml display min plasma logo=1
    display="$(systemctl --user show-environment | sed -n 's/^WAYLAND_DISPLAY=//p')"
    [ -n "$display" ] || return 0
    min="$(kreadconfig6 --file "$rc" --group Login --key MinSeconds --default 2)"
    plasma="$(kreadconfig6 --file "$rc" --group Login --key PlasmaTheme --default "")"
    if [ -n "$plasma" ]; then
        if start_plasma_splash "$plasma" "$display" "$min"; then
            say "login splash started: Plasma theme $plasma"
            return 0
        fi
        say "login splash: Plasma theme $plasma cannot be shown (no ksplashqml, or no such splash); using the Caelestia design"
    fi
    qs="$(command -v quickshell || command -v qs)" || return 0
    shell_config="${CAELESTIA_SHELL_CONFIG:-$HOME/.config/quickshell/caelestia/shell.qml}"
    qml="$(dirname "$shell_config")/modules/splash/shell.qml"
    if [ ! -r "$qml" ]; then
        say "the login splash is on but $qml is missing; skipped"
        return 0
    fi
    [ "$(kreadconfig6 --file "$rc" --group Login --key ShowLogo --default true)" = false ] && logo=0
    WAYLAND_DISPLAY="$display" CAELESTIA_SPLASH_MIN="$min" CAELESTIA_SPLASH_LOGO="$logo" \
        QS_NO_RELOAD_POPUP=1 \
        timeout --kill-after=3 30 "$qs" -n -p "$qml" >"$XDG_RUNTIME_DIR/caelestia-splash.log" 2>&1 &
    splash_pid=$!
    say "login splash started: Caelestia design"
}
start_splash || true

# 3b. Start the Plasma helpers this session needs: the polkit agent (password prompts) and
#     powerdevil (idle actions, screen brightness). Both are PartOf=graphical-session.target,
#     so they stop with the session, but they are not ordered after KWin, so they are started
#     here, now that KWin is up. Not with After=graphical-session.target drop-ins on them
#     (finding C: that made an ordering cycle). --no-block, because powerdevil is Type=dbus
#     and should not delay step 4.
for unit in plasma-polkit-agent.service plasma-powerdevil.service; do
    if systemctl --user cat "$unit" >/dev/null 2>&1; then
        systemctl --user start --no-block "$unit" || say "could not start $unit"
    else
        say "$unit is not installed; skipped"
    fi
done

# 4. Stay alive until KWin exits; the EXIT trap (cleanup) then tears everything down. The wait
#    builtin lets a signal interrupt the sleep at once.
while systemctl --user is-active --quiet caelestia-kwin.service; do
    sleep 2 &
    wait $!
done
